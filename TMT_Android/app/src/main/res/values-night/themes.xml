<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Theme.TMT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorOnPrimary">@color/bg_light</item>
        <item name="colorPrimaryContainer">#3A1E2C</item>
        <item name="colorOnPrimaryContainer">@color/pink_light</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/pink_primary</item>
        <item name="colorOnSecondary">@color/bg_light</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_soft_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_main_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_muted_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Circular Shape Appearance for Avatars -->
    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
